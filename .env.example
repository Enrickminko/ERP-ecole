# Copy this file to .env before running docker compose:
#   cp .env.example .env
# .env is git-ignored. .env.example IS committed so teammates know what is needed.

# ---- PostgreSQL ----
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=erp_password
POSTGRES_DB=erp_db

# ---- Auth Service ----
# In a real system this must be a long random string. Keep it secret.
JWT_SECRET=super_secret_change_me_in_production_1234567890
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
